{
  "name": "@lumenglide/embed-sdk",
  "version": "0.1.0",
  "description": "Embeddable passkey smart-account + gasless transaction SDK for Stellar/Soroban dApps.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
